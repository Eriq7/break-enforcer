# 复制这个文件成 .env，然后自己填。.env 已经被 .gitignore 挡住，不会进仓库。
#
# key 从这里取：https://dashboard.stripe.com -> Developers -> API keys
#
# 两个 key 必须是同一个模式，要么都 live 要么都 test，程序会检查。
# 先用 test 跑一遍验证流程没写错（test 模式用 4242 4242 4242 4242 这张假卡），
# 确认无误之后再换成 live 用真卡。

STRIPE_SECRET_KEY=sk_test_在这里粘贴
STRIPE_PUBLISHABLE_KEY=pk_test_在这里粘贴

# 实验 2 要压多久，单位小时。默认 120 = 5 天，跟产品设计一致。
HOLD_HOURS=120

# 本地端口，被占了就改
PORT=4242
